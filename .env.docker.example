DJANGO_SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://USER:PASSWORD@db:5432/DATABASE

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1

# Paper trading knobs (optional)
PAPER_FEES_PER_SHARE=0
PAPER_FLAT_COMMISSION=0
PAPER_SLIPPAGE_BPS=0
PAPER_BACKTEST_FILL_MODE=next_open
PAPER_SIMULATION_CLOCK=

# Alpaca paper execution (never commit real values)
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER_DATA_URL=https://data.alpaca.markets
ALPACA_PAPER_EXECUTION_ENABLED=false
ALPACA_PAPER_STOCK_FEED=iex
ALPACA_PAPER_OPTION_FEED=indicative
ALPACA_PAPER_MAX_OPEN_POSITIONS=2
ALPACA_PAPER_MAX_SPREAD_PCT=8
ALPACA_PAPER_CONFIRM_SECONDS=60
ALPACA_PAPER_MAX_QUOTE_AGE_SECONDS=30

# Telegram trade lifecycle notifications (never commit real values)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OPERATIONS_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=false
QUANTELLE_RESEARCH_OPERATOR_TOKEN=
QUANTELLE_RESEARCH_OPERATOR_USERNAME=quantelle-research-operator
# Dedicated shadow paper account. Do not set credentials until separately approved.
SHADOW_TRADING_ENABLED=false
SHADOW_EXECUTION_CONFIRMED=false
SHADOW_EMERGENCY_PAUSE=true
SHADOW_ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
SHADOW_ALPACA_PAPER_API_KEY=
SHADOW_ALPACA_PAPER_SECRET_KEY=
SHADOW_MAX_CONCURRENT_POSITIONS=1
SHADOW_MAX_DAILY_ENTRIES=2
SHADOW_MAX_QUOTE_AGE_SECONDS=20
SHADOW_MAX_SPREAD_PCT=12
SHADOW_AUTONOMOUS_ENTRIES_ENABLED=false
SHADOW_ALLOWED_SETUP_ID=
