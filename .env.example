# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
ALLOWED_HOSTS=quantelle.io,www.quantelle.io
CSRF_TRUSTED_ORIGINS=https://quantelle.io,https://www.quantelle.io
DATABASE_URL=postgres://stockscores:replace-me@db:5432/stockscores
CACHE_URL=redis://redis:6379/0

# Email
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=support@quantelle.io
EMAIL_HOST_PASSWORD=replace-with-provider-app-password
DEFAULT_FROM_EMAIL=support@quantelle.io

# Stripe sandbox. Use only pk_test_, sk_test_, price_, and whsec_ values here
# until the complete sandbox flow has passed.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_APP_URL=https://quantelle.io

# Alpaca paper execution
ALPACA_PAPER_EXECUTION_ENABLED=false
ALPACA_PAPER_API_KEY=replace-me
ALPACA_PAPER_SECRET_KEY=replace-me
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
